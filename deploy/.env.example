# 复制为 deploy/.env，并替换为高强度随机值；deploy/.env 不得提交。
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
DB_USERNAME=shop_user
DB_PASSWORD=replace-with-a-long-random-app-password

# 生产域名，例如 https://market.example.com
# 本地 Docker 访问示例：PUBLIC_ORIGIN=http://localhost（HTTP_PORT 不是 80 时必须带端口）
PUBLIC_ORIGIN=https://replace-with-your-domain.example
HTTP_PORT=80

# 可选；不使用 AI 时保持为空。
AI_BARGAIN_API_KEY=
DASH_SCOPE_API_KEY=
